<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IT Open House 2026 - ระบบลงทะเบียน</title>

    <!-- นำเข้าฟอนต์ Inter จาก Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- นำเข้า Tailwind CSS สำหรับการจัดการสไตล์และ Layout -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <!-- นำเข้า Lucide Icons สำหรับแสดงไอคอนแบบเวกเตอร์ -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        /* ซ่อนการแสดงผลลูกศรขึ้นลงใน input type="number" */
        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type="number"] {
            -moz-appearance: textfield;
        }
    </style>
</head>
<body class="min-h-screen bg-[#f8fafc] font-sans pb-12">

    <!-- การแจ้งเตือน (Toast Notification) จะแสดงเมื่อส่งข้อมูลสำเร็จ ซ่อนเป็นค่าเริ่มต้นด้วย opacity-0 และ -translate-y-full -->
    <div id="successToast" class="fixed top-6 right-6 z-50 bg-emerald-500 text-white px-6 py-4 rounded-xl shadow-xl flex items-center gap-3 transition-all duration-300 transform -translate-y-full opacity-0 pointer-events-none">
        <i data-lucide="check-circle-2" class="w-6 h-6"></i>
        <div>
            <p class="font-bold">สำเร็จ!</p>
            <p class="text-sm text-emerald-100">ส่งข้อมูลเข้าระบบเรียบร้อยแล้ว</p>
        </div>
    </div>

    <!-- ส่วนหัวของเว็บไซต์ (Header) -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-40 shadow-sm">
        <div class="max-w-5xl mx-auto px-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between py-4 gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-gradient-to-br from-blue-600 to-indigo-600 rounded-xl flex items-center justify-center shadow-inner">
                        <i data-lucide="building-2" class="w-6 h-6 text-white"></i>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-gray-900 leading-tight">IT Open House 2026</h1>
                        <p class="text-sm text-blue-600 font-medium">ระบบลงทะเบียน (Google Sheets)</p>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- ส่วนเนื้อหาหลักและฟอร์มลงทะเบียน -->
    <main class="max-w-7xl mx-auto px-4 mt-8">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8 max-w-3xl mx-auto">
            
            <div class="mb-8 text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 rounded-full mb-4">
                    <i data-lucide="building-2" class="w-8 h-8 text-blue-600"></i>
                </div>
                <h2 class="text-2xl font-bold text-gray-800">แบบฟอร์มลงทะเบียน</h2>
                <p class="text-gray-500 mt-2">เข้าร่วมงาน Open House คณะเทคโนโลยีสารสนเทศ</p>
            </div>

            <form id="registrationForm" class="space-y-6">
                <!-- ส่วนที่ 1: ข้อมูลส่วนตัว -->
                <div class="bg-slate-50 p-6 rounded-xl border border-slate-100 space-y-4">
                    <h3 class="font-semibold text-slate-800 flex items-center gap-2 border-b border-slate-200 pb-2">
                        <i data-lucide="user" class="w-5 h-5 text-blue-500"></i> ข้อมูลส่วนตัว
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-gray-700 mb-1">คำนำหน้า *</label>
                            <select name="title" required class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all bg-white">
                                <option value="นาย">นาย</option>
                                <option value="นางสาว">นางสาว</option>
                                <option value="นาง">นาง</option>
                            </select>
                        </div>
                        <div class="md:col-span-3">
                            <label class="block text-sm font-medium text-gray-700 mb-1">ชื่อ-นามสกุล *</label>
                            <input type="text" name="fullName" required placeholder="เช่น สมชาย ใจดี" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all bg-white">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">เพศ *</label>
                            <select name="gender" required class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all bg-white">
                                <option value="ชาย">ชาย</option>
                                <option value="หญิง">หญิง</option>
                                <option value="อื่นๆ">อื่นๆ</option>
                                <option value="ไม่ระบุ">ไม่ระบุ</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">อายุ (ปี) *</label>
                            <input type="number" name="age" required min="10" max="99" placeholder="เช่น 17" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all bg-white">
                        </div>
                    </div>
                </div>

                <!-- ส่วนที่ 2: ข้อมูลการศึกษา -->
                <div class="bg-slate-50 p-6 rounded-xl border border-slate-100 space-y-4">
                    <h3 class="font-semibold text-slate-800 flex items-center gap-2 border-b border-slate-200 pb-2">
                        <i data-lucide="school" class="w-5 h-5 text-indigo-500"></i> ข้อมูลการศึกษา
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">ระดับชั้นเรียน *</label>
                            <select name="grade" required class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all bg-white">
                                <option value="ม.4">มัธยมศึกษาปีที่ 4</option>
                                <option value="ม.5">มัธยมศึกษาปีที่ 5</option>
                                <option value="ม.6" selected>มัธยมศึกษาปีที่ 6</option>
                                <option value="ปวช.">ปวช.</option>
                                <option value="ปวส.">ปวส.</option>
                                <option value="อื่นๆ">อื่นๆ</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">ชื่อโรงเรียน *</label>
                            <input type="text" name="school" required placeholder="ระบุชื่อโรงเรียน" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all bg-white">
                        </div>
                    </div>
                </div>

                <!-- ส่วนที่ 3: ข้อมูลติดต่อ -->
                <div class="bg-slate-50 p-6 rounded-xl border border-slate-100 space-y-4">
                    <h3 class="font-semibold text-slate-800 flex items-center gap-2 border-b border-slate-200 pb-2">
                         <i data-lucide="phone" class="w-5 h-5 text-emerald-500"></i> ข้อมูลติดต่อ
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1 flex items-center gap-1">
                                เบอร์โทรศัพท์ *
                            </label>
                            <input type="tel" name="phone" required placeholder="เช่น 0812345678" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all bg-white">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1 flex items-center gap-1">
                                 Line ID
                            </label>
                            <input type="text" name="lineId" placeholder="ระบุ Line ID (ถ้ามี)" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all bg-white">
                        </div>
                    </div>
                </div>

                <!-- ส่วนที่ 4: สาขาวิชาที่สนใจ (ใช้โครงสร้างแบบ Radio ที่ปรับแต่งสไตล์ด้วย Tailwind) -->
                <div class="pt-4">
                    <label class="flex items-center gap-2 text-base font-semibold text-gray-800 mb-4">
                        <i data-lucide="book-open" class="w-5 h-5 text-orange-500"></i> 
                        สาขาวิชาที่สนใจของคณะไอที (เลือก 1 สาขา) *
                    </label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        
                        <!-- Option 1 -->
                        <div class="relative">
                            <input type="radio" name="major" id="major1" value="เทคโนโลยีธุรกิจดิจิทัล" class="peer sr-only" required checked>
                            <label for="major1" class="flex items-center p-4 rounded-xl border cursor-pointer transition-all duration-200 border-gray-200 hover:border-blue-300 hover:bg-slate-50 peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:ring-2 peer-checked:ring-blue-200 peer-checked:shadow-sm">
                                <div class="w-5 h-5 border-2 border-gray-300 rounded-full flex items-center justify-center mr-3 peer-checked:border-blue-600 transition-colors">
                                    <div class="w-2.5 h-2.5 bg-blue-600 rounded-full opacity-0 transition-opacity" id="dot1"></div>
                                </div>
                                <span class="text-sm font-medium text-gray-700 peer-checked:font-semibold peer-checked:text-blue-800 transition-all">เทคโนโลยีธุรกิจดิจิทัล</span>
                            </label>
                        </div>

                        <!-- Option 2 -->
                        <div class="relative">
                            <input type="radio" name="major" id="major2" value="เทคโนโลยีสารสนเทศและนวัตกรรมดิจิทัล" class="peer sr-only" required>
                            <label for="major2" class="flex items-center p-4 rounded-xl border cursor-pointer transition-all duration-200 border-gray-200 hover:border-blue-300 hover:bg-slate-50 peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:ring-2 peer-checked:ring-blue-200 peer-checked:shadow-sm">
                                <div class="w-5 h-5 border-2 border-gray-300 rounded-full flex items-center justify-center mr-3 peer-checked:border-blue-600 transition-colors">
                                    <div class="w-2.5 h-2.5 bg-blue-600 rounded-full opacity-0 transition-opacity" id="dot2"></div>
                                </div>
                                <span class="text-sm font-medium text-gray-700 peer-checked:font-semibold peer-checked:text-blue-800 transition-all">เทคโนโลยีสารสนเทศและนวัตกรรมดิจิทัล</span>
                            </label>
                        </div>

                        <!-- Option 3 -->
                        <div class="relative">
                            <input type="radio" name="major" id="major3" value="ดิจิทัลมีเดียอาร์ต" class="peer sr-only" required>
                            <label for="major3" class="flex items-center p-4 rounded-xl border cursor-pointer transition-all duration-200 border-gray-200 hover:border-blue-300 hover:bg-slate-50 peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:ring-2 peer-checked:ring-blue-200 peer-checked:shadow-sm">
                                <div class="w-5 h-5 border-2 border-gray-300 rounded-full flex items-center justify-center mr-3 peer-checked:border-blue-600 transition-colors">
                                    <div class="w-2.5 h-2.5 bg-blue-600 rounded-full opacity-0 transition-opacity" id="dot3"></div>
                                </div>
                                <span class="text-sm font-medium text-gray-700 peer-checked:font-semibold peer-checked:text-blue-800 transition-all">ดิจิทัลมีเดียอาร์ต</span>
                            </label>
                        </div>

                        <!-- Option 4 -->
                        <div class="relative">
                            <input type="radio" name="major" id="major4" value="วิศวกรรมความปลอดภัย" class="peer sr-only" required>
                            <label for="major4" class="flex items-center p-4 rounded-xl border cursor-pointer transition-all duration-200 border-gray-200 hover:border-blue-300 hover:bg-slate-50 peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:ring-2 peer-checked:ring-blue-200 peer-checked:shadow-sm">
                                <div class="w-5 h-5 border-2 border-gray-300 rounded-full flex items-center justify-center mr-3 peer-checked:border-blue-600 transition-colors">
                                    <div class="w-2.5 h-2.5 bg-blue-600 rounded-full opacity-0 transition-opacity" id="dot4"></div>
                                </div>
                                <span class="text-sm font-medium text-gray-700 peer-checked:font-semibold peer-checked:text-blue-800 transition-all">วิศวกรรมความปลอดภัย</span>
                            </label>
                        </div>

                        <!-- Option 5 -->
                        <div class="relative">
                            <input type="radio" name="major" id="major5" value="ไม่สนใจ" class="peer sr-only" required>
                            <label for="major5" class="flex items-center p-4 rounded-xl border cursor-pointer transition-all duration-200 border-gray-200 hover:border-blue-300 hover:bg-slate-50 peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:ring-2 peer-checked:ring-blue-200 peer-checked:shadow-sm">
                                <div class="w-5 h-5 border-2 border-gray-300 rounded-full flex items-center justify-center mr-3 peer-checked:border-blue-600 transition-colors">
                                    <div class="w-2.5 h-2.5 bg-blue-600 rounded-full opacity-0 transition-opacity" id="dot5"></div>
                                </div>
                                <span class="text-sm font-medium text-gray-700 peer-checked:font-semibold peer-checked:text-blue-800 transition-all">ไม่สนใจ</span>
                            </label>
                        </div>

                    </div>
                </div>

                <!-- ส่วนที่ 5: ปุ่มกดยืนยันการลงทะเบียน -->
                <div class="pt-6 mt-6 border-t border-gray-100">
                    <button type="submit" id="submitBtn" class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 disabled:opacity-70 disabled:cursor-not-allowed text-white font-semibold py-4 px-6 rounded-xl transition-all shadow-md hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 flex items-center justify-center gap-2 text-lg">
                        <i data-lucide="check-circle-2" id="btnIcon" class="w-6 h-6"></i>
                        <i data-lucide="loader-2" id="btnSpinner" class="w-6 h-6 animate-spin hidden"></i>
                        <span id="btnText">ยืนยันการลงทะเบียน</span>
                    </button>
                </div>
            </form>
        </div>
    </main>
    
    <footer class="mt-16 text-center text-sm text-gray-400 pb-8">
        <p>© 2026 IT Faculty Open House Registration System.</p>
    </footer>

    <script>
        // กำหนด URL ของ Google Apps Script ที่ Deploy เสร็จแล้วลงไปที่นี่
        const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbz31gvcDx_BZo09rZnsjGyMqs3IB_GJtlflfBSSzQe-lrhJCrwRYGIsIMtcqgzE47pf/exec';

        // วาดไอคอนจาก Lucide
        lucide.createIcons();

        // อ้างอิง Elements ต่างๆ ใน DOM
        const form = document.getElementById('registrationForm');
        const submitBtn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const btnIcon = document.getElementById('btnIcon');
        const btnSpinner = document.getElementById('btnSpinner');
        const successToast = document.getElementById('successToast');
        const radioInputs = document.querySelectorAll('input[type="radio"][name="major"]');

        // ฟังก์ชันอัปเดตสไตล์ของจุดข้างใน Radio ปุ่ม
        function updateRadioDots() {
            radioInputs.forEach((radio, index) => {
                const dot = document.getElementById(`dot${index + 1}`);
                if (radio.checked) {
                    dot.classList.remove('opacity-0');
                    dot.classList.add('opacity-100');
                } else {
                    dot.classList.remove('opacity-100');
                    dot.classList.add('opacity-0');
                }
            });
        }

        // เพิ่ม Event Listener ให้ Radio เพื่อเปลี่ยนจุดวงกลมด้านในเมื่อถูกคลิก
        radioInputs.forEach(radio => {
            radio.addEventListener('change', updateRadioDots);
        });
        
        // เรียกใช้ฟังก์ชันทันทีเพื่อแสดงจุดของค่าเริ่มต้น (Default Checked)
        updateRadioDots();

        // ฟังก์ชันจัดการตอนกดปุ่มส่งฟอร์ม (Submit)
        form.addEventListener('submit', async function(e) {
            e.preventDefault(); // ป้องกันการรีเฟรชหน้าเว็บ

            // เปลี่ยนสถานะปุ่มเป็นโหลด
            submitBtn.disabled = true;
            btnText.textContent = 'กำลังส่งข้อมูล...';
            btnIcon.classList.add('hidden');
            btnSpinner.classList.remove('hidden');

            // เตรียมข้อมูลฟอร์ม
            const formData = new FormData(form);
            // แทรกลงวันที่เวลาปัจจุบันในรูปแบบ ไทย
            formData.append('timestamp', new Date().toLocaleString('th-TH'));

            try {
                if (GOOGLE_SCRIPT_URL === 'YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL') {
                    // หากยังไม่ได้ใส่ URL ของจริง ให้หน่วงเวลาจำลอง (Mocking)
                    console.log("Mocking Google Sheets Data:");
                    for (let [key, value] of formData.entries()) {
                        console.log(`${key}: ${value}`);
                    }
                    await new Promise(resolve => setTimeout(resolve, 1200));
                } else {
                    // ส่งข้อมูลไปยัง Google Apps Script
                    await fetch(GOOGLE_SCRIPT_URL, {
                        method: 'POST',
                        body: formData,
                        mode: 'no-cors' // สำคัญมาก ป้องกันปัญหาข้ามโดเมน (CORS)
                    });
                }
                
                // การส่งสำเร็จ -> แสดงข้อความแจ้งเตือน (Toast)
                successToast.classList.remove('-translate-y-full', 'opacity-0');
                successToast.classList.add('translate-y-0', 'opacity-100');
                
                // ล้างค่าข้อมูลในฟอร์มเพื่อเตรียมรับคนถัดไป
                form.reset();
                updateRadioDots(); // อัปเดตจุด radio ให้กลับเป็นค่าตั้งต้น

                // ซ่อนการแจ้งเตือนหลังจากผ่านไป 3 วินาที
                setTimeout(() => {
                    successToast.classList.remove('translate-y-0', 'opacity-100');
                    successToast.classList.add('-translate-y-full', 'opacity-0');
                }, 3000);

            } catch (error) {
                console.error("Error submitting to Google Sheets: ", error);
                alert("เกิดข้อผิดพลาดในการส่งข้อมูล โปรดลองใหม่อีกครั้ง");
            } finally {
                // คืนสถานะปุ่มกลับมาเป็นปกติ
                submitBtn.disabled = false;
                btnText.textContent = 'ยืนยันการลงทะเบียน';
                btnIcon.classList.remove('hidden');
                btnSpinner.classList.add('hidden');
            }
        });
    </script>
</body>
</html>
